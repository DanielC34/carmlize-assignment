# Copy to .env and adjust.

# --- App ---
COMPANY_NAME=Carmlize
APP_NAME=Carmlize
PORT=3000

# --- Optional RPC (Blockchain Developer take-home; not required for local DX) ---
# Without RPC_URL, /api/v1/onchain/* should use fixtures (see BLOCKCHAIN_DEVELOPER.md).
# CHAIN_ID=1
# RPC_URL=

# --- AI (optional) ---
# Without a key, /api/v1/ai/brief returns a heuristic brief so local DX still works.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
