{
  "name": "carmlize",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "prestart": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('client/.next',{recursive:true,force:true})\"",
    "dev": "npm run dev -w carmlize-client",
    "start": "npm run start -w carmlize-client",
    "client:build": "npm run build -w carmlize-client",
    "test": "node --test client/test/*.test.js"
  },
  "dependencies": {
    "klinecharts": "^10.0.0-beta1",
    "lightweight-charts": "^5.1.0",
    "next": "14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.19",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@metamask/logo": "^4.0.0",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "simple-icons": "^14.15.0",
    "tailwindcss": "^3.4.17",
    "animatecss-tailwind-adapter": "^2.0.6",
    "typescript": "~5.6.3"
  }
}
